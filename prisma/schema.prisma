// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique // admin, manager, employee
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique // e.g. CREATE_RECORD, READ_RECORD, UPDATE_RECORD, DELETE_RECORD
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Organization {
  id Int @id @default(autoincrement())

  // Company Details
  name           String
  companyLogo    String?
  companyAddress String?
  email          String
  website        String?
  mobileNumber   String

  // Bank Details
  bankName              String?
  bankBranchName        String?
  bankIfsc              String?
  bankAccountNumber     String?
  bankAccountHolderName String?
  signatureStamp        String?

  // GST Details
  gstNumber String?
  panNumber String?

  // Trial
  trialUsage           Boolean   @default(false)
  trialPeriodStartDate DateTime?
  trialPeriodEndDate   DateTime?

  // Stats
  creditAvailable     Int               @default(0)
  totalPurchaseAmount Int               @default(0)
  totalSaleAmount     Int               @default(0)
  totalProfit         Int               @default(0)
  totalTurnOver       Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  users               User[]
  suppliers           Supplier[]
  buyers              Buyer[]
  commodities         Commodity[]
  deductions          Deduction[]
  supplierInvoices    SupplierInvoice[]
  buyerInvoices       BuyerInvoice[]
  serviceProviders    ServiceProvider[]
  expenditureTypes    ExpenditureType[]
  transactions        Transaction[]
  expenditures        Expenditure[]
}

model User {
  id             Int          @id @default(autoincrement())
  role           Role         @relation(fields: [roleId], references: [id])
  roleId         Int
  firstName      String
  lastName       String
  username       String       @unique
  password       String
  profilePicture String?
  mobileNumber   String
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  suppliers        Supplier[]
  buyers           Buyer[]
  commodities      Commodity[]
  deductions       Deduction[]
  supplierInvoices SupplierInvoice[]
  buyerInvoices    BuyerInvoice[]
  serviceProviders ServiceProvider[]
  expenditureTypes ExpenditureType[]
  transactions     Transaction[]
  expenditures     Expenditure[]
}

model Supplier {
  id                   Int               @id @default(autoincrement())
  supplierName         String
  supplierMobileNumber String
  supplierAddress      String
  totalAmount          Int               @default(0)
  pendingAmount        Int               @default(0)
  paidAmount           Int               @default(0)
  profilePicture       String?
  isWhatsappEnabled    Boolean           @default(false)
  user                 User?             @relation(fields: [createdBy], references: [id])
  createdBy            Int?
  organization         Organization      @relation(fields: [organizationId], references: [id])
  organizationId       Int
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  supplierInvoices     SupplierInvoice[]
  transactions         Transaction[]
}

model Buyer {
  id                Int            @id @default(autoincrement())
  buyerName         String
  buyerMobileNumber String
  buyerAddress      String
  email             String?
  totalAmount       Int            @default(0)
  pendingAmount     Int            @default(0)
  paidAmount        Int            @default(0)
  profilePicture    String?
  user              User           @relation(fields: [createdBy], references: [id])
  createdBy         Int
  organization      Organization   @relation(fields: [organizationId], references: [id])
  organizationId    Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  buyerInvoices     BuyerInvoice[]
  transactions      Transaction[]
}

model Commodity {
  id                Int               @id @default(autoincrement())
  name              String
  availableQuantity Int               @default(0)
  user              User              @relation(fields: [createdBy], references: [id])
  createdBy         Int
  organization      Organization      @relation(fields: [organizationId], references: [id])
  organizationId    Int
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  supplierInvoices  SupplierInvoice[]
  buyerInvoices     BuyerInvoice[]
}

enum DeductionType {
  WEIGHT
  AMOUNT
}

model Deduction {
  id                Int              @id @default(autoincrement())
  type              DeductionType    @default(AMOUNT)
  description       String?
  user              User             @relation(fields: [createdBy], references: [id])
  createdBy         Int
  organization      Organization     @relation(fields: [organizationId], references: [id])
  organizationId    Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])
  supplierInvoiceId Int?
  buyerInvoice      BuyerInvoice?    @relation(fields: [buyerInvoiceId], references: [id])
  buyerInvoiceId    Int?
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

model SupplierInvoice {
  id                   Int           @id @default(autoincrement())
  invoiceNumber        String        @unique
  supplier             Supplier      @relation(fields: [supplierId], references: [id])
  supplierId           Int
  commodity            Commodity     @relation(fields: [commodityId], references: [id])
  commodityId          Int
  purchasePrice        Int
  totalQuantity        Int
  deductions           Deduction[]
  totalDeductionAmount Int           @default(0)
  subtotal             Int           @default(0)
  roundedOffAmount     Int           @default(0)
  totalInvoiceAmount   Int           @default(0)
  notes                String?
  invoiceUrl           String?
  paymentStatus        PaymentStatus @default(UNPAID)
  user                 User          @relation(fields: [createdBy], references: [id])
  createdBy            Int
  organization         Organization  @relation(fields: [organizationId], references: [id])
  organizationId       Int
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model BuyerInvoice {
  id                   Int           @id @default(autoincrement())
  invoiceNumber        String        @unique
  buyer                Buyer         @relation(fields: [buyerId], references: [id])
  buyerId              Int
  commodity            Commodity     @relation(fields: [commodityId], references: [id])
  commodityId          Int
  sellingPrice         Int
  totalQuantity        Int
  deductions           Deduction[]
  totalDeductionAmount Int           @default(0)
  subtotal             Int           @default(0)
  roundedOffAmount     Int           @default(0)
  totalInvoiceAmount   Int           @default(0)
  note                 String?
  invoiceUrl           String?
  paymentStatus        PaymentStatus @default(UNPAID)
  user                 User          @relation(fields: [createdBy], references: [id])
  createdBy            Int
  organization         Organization  @relation(fields: [organizationId], references: [id])
  organizationId       Int
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model ServiceProvider {
  id             Int           @id @default(autoincrement())
  name           String
  pendingAmount  Int           @default(0)
  paidAmount     Int           @default(0)
  totalAmount    Int           @default(0)
  mobileNumber   String
  user           User          @relation(fields: [createdBy], references: [id])
  createdBy      Int
  organization   Organization  @relation(fields: [organizationId], references: [id])
  organizationId Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  expenditures   Expenditure[]
  transactions   Transaction[]
}

model ExpenditureType {
  id               Int           @id @default(autoincrement())
  name             String
  description      String?
  totalExpenditure Int           @default(0)
  user             User          @relation(fields: [createdBy], references: [id])
  createdBy        Int
  organization     Organization  @relation(fields: [organizationId], references: [id])
  organizationId   Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  expenditures     Expenditure[]
}

model Expenditure {
  id                Int             @id @default(autoincrement())
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id])
  serviceProviderId Int
  expenditureType   ExpenditureType @relation(fields: [expenditureTypeId], references: [id])
  expenditureTypeId Int
  expenditureAmount Int
  description       String?
  user              User            @relation(fields: [createdBy], references: [id])
  createdBy         Int
  organization      Organization    @relation(fields: [organizationId], references: [id])
  organizationId    Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionMode {
  CASH
  ONLINE
  CHEQUE
  UPI
  RTGS
  NEFT
  IMPS
  PAYTM
  PHONEPE
  PAYPAL
  OTHER
}

enum TransactionPartyType {
  SUPPLIER
  BUYER
  SERVICE_PROVIDER
}

model Transaction {
  id                         Int                  @id @default(autoincrement())
  transactionType            TransactionType
  transactionMode            TransactionMode
  transactionReferenceNumber String?
  transactionAmount          Int
  transactionDate            DateTime
  transactionDescription     String?
  transactionReceiptUrl      String?
  transactionPartyType       TransactionPartyType
  transactionPartyId         Int
  supplier                   Supplier?            @relation(fields: [supplierId], references: [id])
  supplierId                 Int?
  buyer                      Buyer?               @relation(fields: [buyerId], references: [id])
  buyerId                    Int?
  serviceProvider            ServiceProvider?     @relation(fields: [serviceProviderId], references: [id])
  serviceProviderId          Int?
  user                       User                 @relation(fields: [createdBy], references: [id])
  createdBy                  Int
  organization               Organization         @relation(fields: [organizationId], references: [id])
  organizationId             Int
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
}
